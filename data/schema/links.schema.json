{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "links",
  "type": "array",
  "minItems": 1,
  "items": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "label": {
        "type": "string",
        "minLength": 1
      },
      "text": {
        "type": "string",
        "minLength": 1
      },
      "url": {
        "type": "string",
        "pattern": "^(https?://|mailto:)\\S+$"
      },
      "alt": {
        "type": "string",
        "minLength": 1
      }
    },
    "required": [
      "label",
      "text",
      "url",
      "alt"
    ]
  }
}
