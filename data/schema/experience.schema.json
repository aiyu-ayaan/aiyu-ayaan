{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "experience",
  "type": "array",
  "minItems": 1,
  "items": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "period": {
        "type": "string",
        "minLength": 1
      },
      "title": {
        "type": "string",
        "minLength": 1
      },
      "company": {
        "type": "string",
        "minLength": 1
      },
      "highlight": {
        "type": "string",
        "minLength": 1
      },
      "current": {
        "type": "boolean"
      }
    },
    "required": [
      "period",
      "title",
      "company",
      "highlight"
    ]
  }
}
