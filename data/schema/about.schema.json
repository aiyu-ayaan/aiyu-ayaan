{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "about",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "paragraphs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "bullets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "label": {
            "type": "string",
            "minLength": 1
          },
          "text": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "label",
          "text"
        ]
      }
    }
  },
  "required": [
    "paragraphs",
    "bullets"
  ]
}
