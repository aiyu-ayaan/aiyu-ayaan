{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "more-projects",
  "type": "array",
  "minItems": 1,
  "items": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "name": {
        "type": "string",
        "minLength": 1
      },
      "url": {
        "type": "string",
        "pattern": "^(https?://|mailto:)\\S+$"
      },
      "summary": {
        "type": "string",
        "minLength": 1
      }
    },
    "required": [
      "name",
      "url",
      "summary"
    ]
  }
}
