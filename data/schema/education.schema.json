{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "education",
  "type": "array",
  "minItems": 1,
  "items": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "period": {
        "type": "string",
        "minLength": 1
      },
      "degree": {
        "type": "string",
        "minLength": 1
      },
      "school": {
        "type": "string",
        "minLength": 1
      },
      "detail": {
        "type": "string",
        "minLength": 1
      }
    },
    "required": [
      "period",
      "degree",
      "school",
      "detail"
    ]
  }
}
